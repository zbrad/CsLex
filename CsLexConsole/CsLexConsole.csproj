<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>cslex</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>cslex</ToolCommandName>
    <PackageId>CsLex.Tool</PackageId>
    <Description>CsLex lexical analyzer generator as a .NET tool: turns a lex specification into a C# lexer.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\LexLib\LexLib.csproj" />
  </ItemGroup>
</Project>
