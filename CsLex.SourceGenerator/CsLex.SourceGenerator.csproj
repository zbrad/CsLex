<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Roslyn loads generators as netstandard2.0. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- The linked LexLib sources are nullable-oblivious; LexSourceGenerator.cs opts in. -->
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <!-- LexLib's sources are compiled in, with its public types made internal. -->
    <DefineConstants>$(DefineConstants);CSLEX_EMBEDDED</DefineConstants>
    <IsPackable>true</IsPackable>
    <PackageId>CsLex.SourceGenerator</PackageId>
    <Description>Roslyn source generator for CsLex: generates a C# lexer from each .lex file listed as AdditionalFiles.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\LexLib\*.cs" Link="LexLib\%(Filename)%(Extension)" />
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md;AnalyzerReleases.Unshipped.md" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>
</Project>
